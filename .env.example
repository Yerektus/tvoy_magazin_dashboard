# Скопируйте в .env: cp .env.example .env
# В бандл попадают только переменные с приставкой NG_APP_.

# Адрес API. Пусто — относительный /api: верно, когда фронт и API стоят за
# одним доменом. На Railway это разные сервисы, поэтому нужен полный адрес.
NG_APP_API_URL=https://tvoymagazinapi-production.up.railway.app/api
